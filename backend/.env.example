# ========================================================
# SlopeGuard Environment Configuration Template
# Phase 9: Production-Structured MySQL Persistence
# ========================================================
# Copy this file to .env and customize values for your deployment.
# NEVER commit real passwords, signing secrets, or credentials.

# --- Database Configuration (MySQL 8.x) ---
# Default local URL connects to localhost:3306/slopeguard with UTC timezone and utf8mb4
SLOPEGUARD_DB_URL=jdbc:mysql://localhost:3306/slopeguard?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
SLOPEGUARD_DB_USERNAME=root
SLOPEGUARD_DB_PASSWORD=your_secure_db_password_here

# --- Server Port ---
PORT=8080

# --- JWT Authentication ---
# Secret must be at least 32 characters (256 bits) for HMAC-SHA256 compliance
JWT_SECRET=replace_with_a_secure_random_at_least_32_character_secret_key!
JWT_ISSUER=slopeguard-backend
JWT_EXPIRATION_SECONDS=900

# --- Initial Administrator Provisioning ---
# Set to 'true' on initial bootstrapping to provision the administrator account.
ADMIN_ENABLED=false
ADMIN_EMAIL=admin@slopeguard.gov.in
ADMIN_PASSWORD=change_this_admin_password_immediately!
ADMIN_NAME=System Administrator

# --- Photograph & Media Uploads ---
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE=5242880
MAX_PHOTOS_PER_REPORT=5

# --- External Environmental Provider (Open-Meteo) ---
OPEN_METEO_ENABLED=true
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# --- Python AI Microservice ---
AI_SERVICE_ENABLED=true
AI_SERVICE_BASE_URL=http://localhost:8000

# --- CORS Allowed Origins ---
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:8080
